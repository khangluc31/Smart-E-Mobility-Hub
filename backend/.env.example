# Backend environment — copy to .env and fill in
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emobility
CORS_ORIGIN=http://localhost:5173
JOBS_ENABLED=false
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
TELEMETRY_KEY=change-me
DEMO_TIME_SCALE=1
FAULT_PROBABILITY=0
# Initial password for seeded operator1..2 and student1..20 accounts (hashed with bcryptjs cost 10)
SEED_PASSWORD=change-me
