{
  "name": "smart-emobility-hub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n be,fe -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "npm test -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:cycles": "madge --circular --extensions ts backend/src",
    "mock-sensor": "tsx backend/scripts/mock-sensor.ts",
    "smoke": "tsx backend/scripts/smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "madge": "^8.0.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=22"
  }
}
